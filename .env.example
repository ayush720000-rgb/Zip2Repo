# Gemini keys for AI Doctor. Numbered keys are tried in numeric order.
GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""

# Or a comma, space, or newline separated pool:
# GEMINI_API_KEYS="key_a,key_b"

# Legacy single key:
# GEMINI_API_KEY="your_key"

# Optional model overrides
# GEMINI_MODEL="gemini-3.1-flash-lite"
# GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-2.5-flash-lite"

# Optional default GitHub token. Users can also connect their own in the app.
GITHUB_TOKEN=""

# Public address of the site, used for link previews. Optional: the request address is used when unset.
# APP_URL="https://your-domain.example"

PORT=3000
