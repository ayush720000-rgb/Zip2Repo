# GEMINI_API_KEYS: Comma-separated Gemini keys for AI mode. When one key hits its
# limit, the server switches to the next one automatically.
GEMINI_API_KEYS="key_one,key_two,key_three"

# Optional: model name for AI mode (default gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Optional: Default GitHub token for server-side testing (users can also provide this in the UI)
GITHUB_TOKEN=""

# Optional: GitHub OAuth App credentials (if using OAuth web flow)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: Render API Key for direct service management (users can also configure in UI)
RENDER_API_KEY=""

PORT=3000
